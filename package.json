{
  "name": "learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @learning/cli exec vitest run --config vitest.e2e.config.ts && pnpm --filter @learning/web test:interop",
    "build": "pnpm -r build",
    "cli": "pnpm --filter @learning/cli start",
    "web": "pnpm --filter @learning/web build && pnpm --filter @learning/web start",
    "check:design": "pnpm --filter @learning/web check:design"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "ws": "8.22.0"
  }
}
