# Public ingestion token for standalone builds and source CLI processes.
# Node source runs require these values in the process environment; .env is not auto-loaded.
POSTHOG_PROJECT_TOKEN=phc_your_project_token
# Runtime override; otherwise POSTHOG_PROJECT_TOKEN or the bundled token is used.
# LEARNING_TELEMETRY_TOKEN=phc_your_project_token
# Events use https://p.cqu.moe/batch; POSTHOG_HOST is not used.
