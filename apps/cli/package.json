{
  "name": "@learning/cli",
  "version": "0.2.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "bin": {
    "learning": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "pnpm --filter @learning/sdk build && tsc -p tsconfig.json",
    "build": "pnpm --filter @learning/sdk build && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "pnpm run build && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@learning/sdk": "workspace:*",
    "commander": "15.0.0",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
